# Copy this file to .env and adjust the values for your machine.
# The .env file is ignored by git and must never be committed.

# Which configuration to load: development, testing or production.
APP_ENV=development

# Key used to sign session cookies. Generate your own value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-generated-value

# SQLAlchemy connection string. Leave it empty to use the default
# SQLite file stored in instance/invoiceflow.db
DATABASE_URL=

# Address and port the development server binds to.
HOST=127.0.0.1
PORT=5000

# ISO 4217 code used to format the amounts shown in the interface.
CURRENCY=EUR
